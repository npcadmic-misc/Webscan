{
  "name": "深度扫描配置示例",
  "description": "针对Web应用的全面安全扫描配置",
  "target_url": "https://example.com",
  "scan_types": ["basic", "deep", "api"],
  "auth_config": {
    "type": "cookie",
    "value": "session_id=your_session_token_here"
  },
  "max_concurrency": 10,
  "rate_limit": 50,
  "timeout": 30,
  "max_depth": 5,
  "excluded_paths": ["/logout", "/admin/logout"],
  "custom_payloads": [],
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) WebVulnScanner/1.0",
  "report_format": "html"
}
