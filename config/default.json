{
  "scanner": {
    "max_concurrency": 10,
    "rate_limit": 50,
    "timeout": 30,
    "max_depth": 5,
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) WebVulnScanner/1.0"
  },
  "report": {
    "default_format": "html",
    "output_dir": "data/reports",
    "include_poc": true,
    "include_screenshots": false
  },
  "storage": {
    "history_dir": "data/history",
    "logs_dir": "data/logs"
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8000,
    "debug": false
  }
}
